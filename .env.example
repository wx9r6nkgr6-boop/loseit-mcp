# Copy to .env only if you prefer environment configuration. .env is ignored.
# Recommended: run `loseit-mcp import-token`, which writes an owner-only file.

# Optional alternate owner-only token path:
# LOSEIT_TOKEN_FILE=/absolute/path/to/liauth

# Less preferred: an environment variable can be exposed to child processes.
# LOSEIT_TOKEN=

# Usually decoded from the JWT `sub` claim. Set only if your token lacks it.
# LOSEIT_USER_ID=
# LOSEIT_USER_NAME=

# Account UTC offset in whole hours. Auto-detected when unset.
# LOSEIT_HOURS_FROM_GMT=-4

# Canonical local data directory used by loseit-sync.
# LOSEIT_DATA_DIR=/absolute/private/path/loseit-data

# Emergency compatibility overrides after a Lose It! private-interface change.
# LOSEIT_STRONG_NAME=
# LOSEIT_POLICY_HASH=
